###############################################################################
# Sistema Restaurante Global — variables de entorno
#
# Este archivo SOLO lleva valores de ejemplo. El archivo real (.env) nunca se
# versiona. Copiar con:  cp .env.example .env
#
# La contraseña de la base de datos del servidor se lee del .env del servidor
# por SSH, jamás del repositorio.
###############################################################################

APP_NAME="Sistema Restaurante Global"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Caracas

# ── Subdirectorio ───────────────────────────────────────────────────────────
# En local no lleva prefijo. En el servidor (cPanel, subdirectorio) sí, y es
# OBLIGATORIO: sin esto los assets, los formularios y la cookie de sesión
# apuntan a la raíz del dominio y el sitio se ve roto.
APP_URL=http://localhost:8000
ASSET_URL=
# SESSION_PATH=/sistema-restaurante-global
# SESSION_DOMAIN=null

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Base de datos ───────────────────────────────────────────────────────────
# Solo MySQL. SQLite está PROHIBIDO por AGENTS.md §4 trampa 2.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistema_restaurante_global
DB_USERNAME=root
DB_PASSWORD=

# ── Sesión, caché y cola ────────────────────────────────────────────────────
# En cPanel compartido no hay daemon: el scheduler corre la cola con
# queue:work --stop-when-empty. Ver docs/DESPLIEGUE_SERVIDOR.md.
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Correo ──────────────────────────────────────────────────────────────────
# El demo NO envía correos. Todo es in-app.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@ejemplo.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Facturación ─────────────────────────────────────────────────────────────
# Driver del emisor fiscal. Ver specs/000-fundaciones/spec.md FR-06.
# simulated | spooler | electronic
FISCAL_DRIVER=simulated

# Serial y prefijo de serie que usa el driver simulado.
FISCAL_SERIAL=DEMO-SRG-0001

# ── Tasa de cambio ───────────────────────────────────────────────────────────
# Fuente primaria y de respaldo. Si ambas fallan, el sistema cae a tasa
# manual, que queda auditada. Ver specs/030-tasa-cambio/spec.md.
BCV_TASA_URL=
TASA_PROVEEDOR_ALTERNATIVO_URL=

# ── Demo ────────────────────────────────────────────────────────────────────
# Intervalo del polling de la pantalla de cocina, en milisegundos.
KDS_POLL_MS=2000
DEMO_MODO=true

VITE_APP_NAME="${APP_NAME}"